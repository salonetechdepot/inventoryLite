DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simple_inventory?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"

# Stay signed in on this device (days, max 365). Default: 365
SESSION_MAX_AGE_DAYS="365"

# Shown in email subject/body and legal pages
APP_NAME="Simple Inventory"

# Shown on the Privacy Policy page (optional)
# PRIVACY_CONTACT_EMAIL="privacy@yourdomain.com"

# ——— Meta WhatsApp Cloud API (OTP) ———
# From: Meta Business Suite → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Approved template with one body variable for the code, e.g. "Your code is {{1}}"
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
WHATSAPP_OTP_TEMPLATE_LANGUAGE="en_US"
# Optional: WHATSAPP_GRAPH_VERSION="v22.0"

# ——— Resend (email OTP) ———
# From: https://resend.com/api-keys and https://resend.com/domains
RESEND_API_KEY=""
# Must be a verified sender on your Resend domain, e.g. "Inventory <onboarding@yourdomain.com>"
RESEND_FROM_EMAIL=""

# Optional extra secret for OTP HMAC (defaults to JWT_SECRET)
# OTP_PEPPER=""
